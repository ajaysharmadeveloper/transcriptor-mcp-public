# Everything here is optional. Transcriptor runs with no .env file at all:
# the database is a file inside the project and there is nothing to configure
# before the first transcript.
#
# Copy this to <repo>/.env only if you want to change something.

# The database. Leave it unset and Transcriptor uses
# <data_dir>/transcriptor.db, which is what you want unless you have a reason
# to put it elsewhere.
# TRANSCRIPTOR_DATABASE_URL=sqlite:////absolute/path/to/transcriptor.db

# Optional overrides (defaults shown)

# Engine. "auto" picks mlx on Apple Silicon and faster-whisper everywhere else;
# name one explicitly only to test a specific backend.
# TRANSCRIPTOR_ENGINE=auto
# TRANSCRIPTOR_DEVICE=auto              # faster-whisper: auto | cuda | cpu
# TRANSCRIPTOR_COMPUTE_TYPE=            # float16 on cuda, int8 on cpu

# Leave unset to get the right weights for whichever engine is chosen. The two
# engines cannot read each other's model, so setting this pins you to one.
#   mlx             mlx-community/whisper-large-v3-mlx-8bit
#   faster-whisper  Systran/faster-whisper-large-v3
# TRANSCRIPTOR_MODEL=
# TRANSCRIPTOR_DATA_DIR=./.transcriptor
# TRANSCRIPTOR_DB_SCHEMA=public
# TRANSCRIPTOR_MEM_SELF_CAP_GB=4.0
# TRANSCRIPTOR_MEM_SYSTEM_FLOOR_GB=2.5

# Download viewer — serves finished transcripts as loopback links, so a job can
# report a URL instead of pushing thousands of words through the chat window.
# TRANSCRIPTOR_VIEWER_ENABLED=true
# TRANSCRIPTOR_VIEWER_HOST=127.0.0.1
# TRANSCRIPTOR_VIEWER_PORT=8766
